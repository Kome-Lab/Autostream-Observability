cleanup() {
  local status=$?
  local cleanup_failed=false
  set +e
  trap - EXIT HUP INT TERM
  if [[ ${installation_complete} == false && ${commit_started} == true ]]; then
    if [[ ${unit_quiesced} == true ]]; then
      restore_destination "${UNIT_DEST}" "${unit_backup}" || cleanup_failed=true
    fi
    if [[ ${backup_exec_quiesced} == true ]]; then
      restore_destination "${BACKUP_DEST}" "${backup_exec_backup}" || cleanup_failed=true
    fi
    if [[ ${alias_quiesced} == true ]]; then
      restore_destination "${PUBLIC_ALIAS}" "${alias_backup}" || cleanup_failed=true
    fi
    if [[ ${binary_quiesced} == true ]]; then
      restore_destination "${PUBLIC_BINARY}" "${binary_backup}" || cleanup_failed=true
    fi
    if [[ ${env_created} == true ]]; then
      rm -f -- "${ENV_DEST}" || cleanup_failed=true
    fi
    if [[ ${backup_config_created} == true ]]; then
      rm -f -- "${BACKUP_CONFIG_DEST}" || cleanup_failed=true
    fi
    if [[ ${current_switched} == true ]]; then
      if [[ ${current_original_exists} == true ]]; then
        local restore_link
        restore_link=$(reserve_path "${MANAGED_ROOT}" ".current.restore") || cleanup_failed=true
        if [[ -n ${restore_link} ]]; then
          ln -s -- "${current_original_target}" "${restore_link}" || cleanup_failed=true
          if [[ -L ${restore_link} ]]; then
            mv -Tf -- "${restore_link}" "${CURRENT_LINK}" || cleanup_failed=true
          fi
        fi
        [[ -L ${CURRENT_LINK} &&
          $(readlink -- "${CURRENT_LINK}") == "${current_original_target}" ]] || \
          cleanup_failed=true
      else
        rm -f -- "${CURRENT_LINK}" || cleanup_failed=true
        [[ ! -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]] || cleanup_failed=true
      fi
    fi
    systemctl daemon-reload >/dev/null 2>&1 || cleanup_failed=true
  fi
  rm -f -- \
    "${binary_stage}" "${alias_stage}" "${unit_stage}" "${backup_exec_stage}" \
    "${env_stage}" "${backup_config_stage}" "${current_stage}" || cleanup_failed=true
  if [[ ${installation_complete} == false && ${cleanup_failed} == false ]]; then
    rm -f -- "${binary_backup}" "${alias_backup}" "${unit_backup}" "${backup_exec_backup}" || \
      cleanup_failed=true
  fi
  if [[ ${cleanup_failed} == false ]]; then
    rm -rf -- "${STAGE_DIR}" || cleanup_failed=true
  fi
  if [[ ${installation_complete} == false && ${commit_started} == true ]]; then
    sync_common_installation_parents_best_effort || cleanup_failed=true
  fi
  if [[ ${cleanup_failed} == true ]]; then
    printf 'install-autostream-observability: cleanup or rollback was incomplete; inspect %s and any retained *.backup.* files before retrying\n' \
      "${STAGE_DIR}" >&2
    if (( status == 0 )); then
      status=1
    fi
  fi
  exit "${status}"
}
trap cleanup EXIT HUP INT TERM

copy_bound_source "${ARCHIVE_SOURCE}" "${STAGED_SOURCE_DIR}/${ASSET_NAME}" "release archive"
