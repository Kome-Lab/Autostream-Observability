verify_checksum_sidecar "${STAGED_SOURCE_DIR}" "release-manifest.json" "release-manifest.json.sha256"
ARCHIVE_DIGEST=$(awk 'NR == 1 { print $1 }' "${STAGED_SOURCE_DIR}/${ASSET_NAME}.sha256") || \
  die "failed to read the archive digest"
[[ ${ARCHIVE_DIGEST} =~ ^[0-9a-f]{64}$ ]] || die "archive digest is invalid"
readonly ARCHIVE_DIGEST
ARCHIVE_SIZE=$(stat -c '%s' -- "${STAGED_SOURCE_DIR}/${ASSET_NAME}") || \
  die "failed to read the archive size"
[[ ${ARCHIVE_SIZE} =~ ^[1-9][0-9]*$ ]] || die "archive size is invalid"
