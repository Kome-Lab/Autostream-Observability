die() {
  printf 'install-autostream-observability: %s\n' "$*" >&2
  exit 1
}

handle_installer_signal() {
  local requested_status=$1
  if [[ ${signal_transaction_active} == true ]]; then
    deferred_termination_status=${requested_status}
    return 0
  fi
  exit "${requested_status}"
}

restore_installer_signal_traps() {
  if [[ ${cleanup_in_progress} == true ]]; then
    trap '' HUP INT TERM
    return
  fi
  trap 'handle_installer_signal 129' HUP
  trap 'handle_installer_signal 130' INT
  trap 'handle_installer_signal 143' TERM
}

begin_installer_signal_transaction() {
  [[ ${signal_transaction_active} == false ]] || \
    die "nested installer signal transaction is not allowed"
  signal_transaction_active=true
}

finish_installer_signal_transaction() {
  local requested_status
  signal_transaction_active=false
  requested_status=${deferred_termination_status}
  deferred_termination_status=0
  if (( requested_status != 0 )); then
    exit "${requested_status}"
  fi
}

if (( $# != 0 )); then
  die "this installer takes no arguments; run it from the extracted release directory"
fi

for command in \
  awk basename chmod chown cmp dirname find flock getent grep groupadd groupdel head id install jq \
  ln mkdir mktemp mv pwd readlink rm rmdir runuser sha256sum sort stat sync systemctl tar uname uniq \
  useradd userdel wc; do
  command -v "${command}" >/dev/null 2>&1 || die "required command ${command} is unavailable"
done

[[ ${EUID} -eq 0 ]] || die "must run as root"
[[ -f /usr/bin/mariadb-dump &&
  ! -L /usr/bin/mariadb-dump &&
  -x /usr/bin/mariadb-dump ]] || \
  die "/usr/bin/mariadb-dump must be a regular non-symlink executable"

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || \
  die "could not resolve the installer directory"
[[ -n ${SCRIPT_DIR} && ${SCRIPT_DIR} == /* && -d ${SCRIPT_DIR} && ! -L ${SCRIPT_DIR} ]] || \
  die "installer directory is missing or unsafe"
readonly SCRIPT_DIR
ARCHIVE_ROOT_NAME=$(basename -- "${SCRIPT_DIR}") || \
  die "could not resolve the release directory name"
[[ -n ${ARCHIVE_ROOT_NAME} && ${ARCHIVE_ROOT_NAME} != */* ]] || \
  die "release directory name is empty or unsafe"
readonly ARCHIVE_ROOT_NAME
if [[ ! ${ARCHIVE_ROOT_NAME} =~ ^autostream-observability_(v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?)_linux_(amd64|arm64)$ ]]; then
  die "release directory name must look like autostream-observability_v1.2.3_linux_amd64"
fi
readonly VERSION="${BASH_REMATCH[1]}"
readonly ARCH="${BASH_REMATCH[3]}"
SOURCE_DIR=$(dirname -- "${SCRIPT_DIR}") || \
  die "could not resolve the release parent directory"
[[ -n ${SOURCE_DIR} && ${SOURCE_DIR} == /* && -d ${SOURCE_DIR} && ! -L ${SOURCE_DIR} ]] || \
  die "release parent directory is missing or unsafe"
readonly SOURCE_DIR
readonly ASSET_NAME="${ARCHIVE_ROOT_NAME}.tar.gz"
readonly ARCHIVE_SOURCE="${SOURCE_DIR}/${ASSET_NAME}"

case "$(uname -m)" in
  x86_64)
    readonly HOST_ARCH="amd64"
    ;;
  aarch64|arm64)
    readonly HOST_ARCH="arm64"
    ;;
  *)
    die "unsupported host architecture $(uname -m)"
    ;;
esac
[[ ${ARCH} == "${HOST_ARCH}" ]] || die "archive architecture ${ARCH} does not match host architecture ${HOST_ARCH}"

source_identity() {
  stat -c '%d:%i:%s:%Y:%f' -- "$1"
}

validate_source_file() {
  local path=$1
  local label=$2
  [[ -f ${path} && ! -L ${path} ]] || die "${label} must be a regular non-symlink file: ${path}"
}

validate_safe_root_directory() {
  local path=$1
  local label=$2
  local mode
  [[ -d ${path} && ! -L ${path} ]] || die "${label} must be a non-symlink directory: ${path}"
  [[ $(stat -c '%U:%G' -- "${path}") == "root:root" ]] || die "${label} must be owned by root:root"
  mode=$(stat -c '%a' -- "${path}")
  (( (8#${mode} & 07022) == 0 )) || \
    die "${label} must not have special bits or be writable by group or other"
  [[ $(readlink -f -- "${path}") == "${path}" ]] || \
    die "${label} must resolve to its exact canonical path"
}

validate_safe_root_directory_candidate() {
  local path=$1
  local label=$2
  if [[ -e ${path} || -L ${path} ]]; then
    validate_safe_root_directory "${path}" "${label}"
  fi
}

validate_root_sticky_tmp_directory() {
  local path=$1
  local label=$2
  [[ -d ${path} && ! -L ${path} ]] || die "${label} must be a non-symlink directory"
  [[ $(stat -c '%U:%G:%a' -- "${path}") == "root:root:1777" ]] || \
    die "${label} must be owned by root:root with mode 1777"
  [[ $(readlink -f -- "${path}") == "${path}" ]] || \
    die "${label} must resolve to its exact canonical path"
}

register_temporary_rollback_path() {
  local path=$1
  local recorded
  [[ -n ${path} && ${path} == /* ]] || die "temporary rollback path is empty or not absolute"
  for recorded in "${temporary_rollback_paths[@]}"; do
    [[ ${recorded} == "${path}" ]] && return 0
  done
  temporary_rollback_paths+=("${path}")
}

journal_directory_before_mutation() {
  local path=$1
  local retain_if_nonempty=${2-false}
  local snapshot_existed=false
  local snapshot_identity=""
  local snapshot_owner=""
  local snapshot_mode=""

  [[ ${transaction_journal_active} == true ]] || return 0
  [[ ${directory_journaled["${path}"]-false} != true ]] || return 0
  if [[ -e ${path} || -L ${path} ]]; then
    [[ -d ${path} && ! -L ${path} &&
      $(readlink -f -- "${path}") == "${path}" ]] || \
      die "directory path is unsafe before mutation: ${path}"
    snapshot_existed=true
    snapshot_identity=$(stat -c '%d:%i' -- "${path}") || \
      die "could not snapshot directory identity before mutation: ${path}"
    snapshot_owner=$(stat -c '%u:%g' -- "${path}") || \
      die "could not snapshot directory ownership before mutation: ${path}"
    snapshot_mode=$(stat -c '%a' -- "${path}") || \
      die "could not snapshot directory mode before mutation: ${path}"
  fi

  begin_installer_signal_transaction
  directory_journaled["${path}"]=true
  directory_retain_if_nonempty["${path}"]="${retain_if_nonempty}"
  directory_existed["${path}"]="${snapshot_existed}"
  directory_original_identity["${path}"]="${snapshot_identity}"
  directory_original_owner["${path}"]="${snapshot_owner}"
  directory_original_mode["${path}"]="${snapshot_mode}"
  directory_created_identity["${path}"]=""
  journaled_directory_paths+=("${path}")
  finish_installer_signal_transaction
}

record_created_directory_identity() {
  local path=$1
  local identity
  if [[ ${transaction_journal_active} == true &&
    ${directory_journaled["${path}"]-false} == true &&
    ${directory_existed["${path}"]} == false ]]; then
    identity=$(stat -c '%d:%i' -- "${path}") || return 1
    directory_created_identity["${path}"]="${identity}"
  fi
}

create_journaled_directory() {
  local path=$1
  local creation_failed=false

  begin_installer_signal_transaction
  if ! mkdir -- "${path}"; then
    creation_failed=true
  elif ! record_created_directory_identity "${path}"; then
    creation_failed=true
  fi
  finish_installer_signal_transaction
  [[ ${creation_failed} == false ]]
}

ensure_safe_root_directory() {
  local path=$1
  local mode=$2
  local label=$3
  local retain_if_nonempty=${4-false}
  local expected_mode=${mode#0}
  journal_directory_before_mutation "${path}" "${retain_if_nonempty}"
  if [[ ! -e ${path} && ! -L ${path} ]]; then
    create_journaled_directory "${path}" || \
      die "could not create or journal ${label}"
    chown root:root "${path}"
    chmod "${mode}" "${path}"
  fi
  validate_safe_root_directory "${path}" "${label}"
  if [[ ${directory_existed["${path}"]} == false ]]; then
    [[ $(stat -c '%U:%G:%a' -- "${path}") == "root:root:${expected_mode}" ]] || \
      die "${label} owner or mode is invalid after creation"
  fi
}

ensure_root_only_directory() {
  local path=$1
  local retain_if_nonempty=${2-false}
  journal_directory_before_mutation "${path}" "${retain_if_nonempty}"
  validate_root_only_directory_candidate "${path}"
  if [[ ! -e ${path} && ! -L ${path} ]]; then
    create_journaled_directory "${path}" || \
      die "could not create or journal ${path}"
  fi
  chown root:root "${path}"
  chmod 0700 "${path}"
  [[ $(stat -c '%U:%G:%a' -- "${path}") == "root:root:700" ]] || \
    die "${path} owner or mode is invalid"
  [[ $(readlink -f -- "${path}") == "${path}" ]] || \
    die "${path} must resolve to its exact canonical path"
}

validate_root_only_directory_candidate() {
  local path=$1
  local mode
  if [[ -e ${path} || -L ${path} ]]; then
    [[ -d ${path} && ! -L ${path} ]] || die "${path} must be a non-symlink directory"
    [[ $(stat -c '%U:%G' -- "${path}") == "root:root" ]] || \
      die "${path} must be owned by root:root"
    mode=$(stat -c '%a' -- "${path}")
    (( (8#${mode} & 07077) == 0 )) || \
      die "${path} must not have special bits or grant group or other permissions"
    [[ $(readlink -f -- "${path}") == "${path}" ]] || \
      die "${path} must resolve to its exact canonical path"
  fi
}

validate_exact_directory_candidate() {
  local path=$1
  local owner=$2
  local group=$3
  local mode=$4
  local label=$5
  local existing_mode
  local expected_mode=${mode#0}
  [[ ${expected_mode} =~ ^[0-7]{3,4}$ ]] || die "${label} requested mode is invalid"
  if [[ -e ${path} || -L ${path} ]]; then
    [[ -d ${path} && ! -L ${path} ]] || die "${label} must be a non-symlink directory"
    [[ $(stat -c '%U:%G' -- "${path}") == "${owner}:${group}" ]] || \
      die "${label} has unexpected ownership"
    existing_mode=$(stat -c '%a' -- "${path}")
    (( (8#${existing_mode} & 07022) == 0 )) || \
      die "${label} has special bits or is writable by group or other"
    [[ $(readlink -f -- "${path}") == "${path}" ]] || \
      die "${label} must resolve to its exact canonical path"
  fi
}

ensure_exact_directory() {
  local path=$1
  local owner=$2
  local group=$3
  local mode=$4
  local label=$5
  local journal=${6-true}
  local expected_mode=${mode#0}
  if [[ ${journal} == true ]]; then
    journal_directory_before_mutation "${path}"
  fi
  validate_exact_directory_candidate "${path}" "${owner}" "${group}" "${mode}" "${label}"
  if [[ ! -e ${path} && ! -L ${path} ]]; then
    create_journaled_directory "${path}" || \
      die "could not create or journal ${label}"
    if [[ ${journal} == true ]]; then
      [[ -n ${directory_created_identity["${path}"]-} ]] || \
        die "could not bind the created ${label} identity"
    fi
  fi
  chown "${owner}:${group}" "${path}"
  chmod "${mode}" "${path}"
  [[ -d ${path} && ! -L ${path} ]] || die "${label} was not created safely"
  [[ $(stat -c '%U:%G:%a' -- "${path}") == "${owner}:${group}:${expected_mode}" ]] || \
    die "${label} owner or mode is invalid"
  [[ $(readlink -f -- "${path}") == "${path}" ]] || \
    die "${label} must resolve to its exact canonical path"
}

preflight_autostream_account() {
  local autostream_group_gid existing_uid existing_gid
  if getent group autostream >/dev/null 2>&1; then
    autostream_group_gid=$(getent group autostream | awk -F: 'NR == 1 { print $3 }')
    [[ ${autostream_group_gid} =~ ^[0-9]+$ && ${autostream_group_gid} -ne 0 ]] || \
      die "autostream service group must have a non-root numeric GID"
  else
    if getent passwd autostream >/dev/null 2>&1 || id autostream >/dev/null 2>&1; then
      die "autostream service account exists without the autostream group"
    fi
    return 0
  fi

  if getent passwd autostream >/dev/null 2>&1 || id autostream >/dev/null 2>&1; then
    existing_uid=$(id -u autostream)
    existing_gid=$(id -g autostream)
    [[ ${existing_uid} =~ ^[0-9]+$ && ${existing_uid} -ne 0 ]] || \
      die "autostream service account must have a non-root numeric UID"
    [[ ${existing_gid} == "${autostream_group_gid}" ]] || \
      die "autostream service account numeric primary GID does not match the autostream group"
    [[ $(id -gn autostream) == "autostream" ]] || \
      die "autostream service account must use the autostream primary group"
  fi
}

ensure_autostream_account() {
  local autostream_group_gid account_creation_failed=false
  if ! getent group autostream >/dev/null 2>&1; then
    begin_installer_signal_transaction
    if ! groupadd --system autostream; then
      account_creation_failed=true
    else
      created_autostream_group=true
      if ! created_autostream_group_record=$(getent group autostream); then
        account_creation_failed=true
      elif ! created_autostream_group_gid=$(printf '%s\n' "${created_autostream_group_record}" |
        awk -F: 'NR == 1 { print $3 }'); then
        account_creation_failed=true
      fi
    fi
    finish_installer_signal_transaction
    [[ ${account_creation_failed} == false ]] || \
      die "could not create and journal the autostream service group"
  fi
  autostream_group_gid=$(getent group autostream | awk -F: 'NR == 1 { print $3 }')
  [[ ${autostream_group_gid} =~ ^[0-9]+$ && ${autostream_group_gid} -ne 0 ]] || \
    die "autostream service group must have a non-root numeric GID"
  if [[ ${created_autostream_group} == true ]]; then
    [[ ${created_autostream_group_gid} == "${autostream_group_gid}" ]] || \
      die "created autostream service group identity changed during provisioning"
  fi
  if ! id autostream >/dev/null 2>&1; then
    account_creation_failed=false
    begin_installer_signal_transaction
    if ! useradd \
      --system \
      --gid "${autostream_group_gid}" \
      --home-dir /var/lib/autostream \
      --no-create-home \
      --shell /usr/sbin/nologin \
      autostream; then
      account_creation_failed=true
    else
      created_autostream_user=true
      if ! created_autostream_user_uid=$(id -u autostream); then
        account_creation_failed=true
      elif ! created_autostream_user_gid=$(id -g autostream); then
        account_creation_failed=true
      elif ! created_autostream_user_record=$(getent passwd autostream); then
        account_creation_failed=true
      fi
    fi
    finish_installer_signal_transaction
    [[ ${account_creation_failed} == false ]] || \
      die "could not create and journal the autostream service account"
  fi

  [[ $(id -u autostream) =~ ^[0-9]+$ && $(id -u autostream) -ne 0 ]] || \
    die "autostream service account must have a non-root numeric UID"
  [[ $(id -g autostream) == "${autostream_group_gid}" ]] || \
    die "autostream service account numeric primary GID does not match the autostream group"
  [[ $(id -gn autostream) == "autostream" ]] || \
    die "autostream service account must use the autostream primary group"
}

copy_bound_source() {
  local source=$1
  local destination=$2
  local label=$3
  local before_identity before_sha
  validate_source_file "${source}" "${label}"
  before_identity=$(source_identity "${source}")
  before_sha=$(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }')
  install -o root -g root -m 0600 -- "${source}" "${destination}"
  validate_source_file "${source}" "${label}"
  [[ $(source_identity "${source}") == "${before_identity}" ]] || die "${label} changed while it was copied"
  [[ $(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }') == "${before_sha}" ]] || \
    die "${label} content changed while it was copied"
  [[ $(sha256sum -- "${destination}" | awk 'NR == 1 { print $1 }') == "${before_sha}" ]] || \
    die "staged ${label} does not match its source"
}

validate_archive_layout() {
  local archive=$1
  local names=$2
  local verbose=$3
  local canonical_names="${names}.canonical"
  local duplicate_paths entry

  tar -tzf "${archive}" >"${names}"
  tar -tvzf "${archive}" >"${verbose}"
  [[ -s ${names} ]] || die "release archive is empty"
  : >"${canonical_names}"

  while IFS= read -r entry; do
    [[ -n ${entry} ]] || die "release archive contains a blank path"
    [[ ${entry} =~ ^[A-Za-z0-9._/-]+$ ]] || die "release archive contains an unsafe path: ${entry}"
    [[ ${entry} != /* ]] || die "release archive contains an absolute path"
    [[ ! ${entry} =~ (^|/)\.\.(/|$) ]] || die "release archive contains a parent traversal"
    [[ ${entry} != *"//"* &&
      ${entry} != *"/./"* &&
      ${entry} != */. ]] || \
      die "release archive contains a noncanonical path: ${entry}"
    case "${entry}" in
      "${ARCHIVE_ROOT_NAME}"|"${ARCHIVE_ROOT_NAME}/"|"${ARCHIVE_ROOT_NAME}/"*)
        ;;
      *)
        die "release archive must contain exactly the ${ARCHIVE_ROOT_NAME} root"
        ;;
    esac
    printf '%s\n' "${entry%/}" >>"${canonical_names}"
  done <"${names}"

  duplicate_paths=$(sort "${canonical_names}" | uniq -d)
  if [[ -n ${duplicate_paths} ]]; then
    die "release archive contains duplicate paths"
  fi
  if awk 'substr($1, 1, 1) != "-" && substr($1, 1, 1) != "d" { found=1 } END { exit found ? 0 : 1 }' "${verbose}"; then
    die "release archive contains a link or special file"
  fi
}

validate_checksum_inventory() {
  local release_dir=$1
  local scratch_prefix=$2
  local managed_markers=${3:-false}
  local checksums="${release_dir}/checksums.txt"
  local declared="${scratch_prefix}.declared"
  local declared_sorted="${scratch_prefix}.declared.sorted"
  local duplicates="${scratch_prefix}.duplicates"
  local actual="${scratch_prefix}.actual"
  local checksum_pattern='^[0-9a-f]{64}  (\./[A-Za-z0-9._/-]+)$'
  local line path

  : >"${declared}"
  while IFS= read -r line; do
    [[ ${line} =~ ${checksum_pattern} ]] || return 1
    path=${BASH_REMATCH[1]}
    [[ ${path} != "./checksums.txt" &&
      ${path} != *"//"* &&
      ${path} != *"/./"* &&
      ${path} != *"/../"* ]] || return 1
    printf '%s\n' "${path}" >>"${declared}"
  done <"${checksums}"
  [[ -s ${declared} ]] || return 1

  LC_ALL=C sort "${declared}" >"${declared_sorted}"
  uniq -d "${declared_sorted}" >"${duplicates}"
  [[ ! -s ${duplicates} ]] || return 1
  case "${managed_markers}" in
    false)
      (
        cd -- "${release_dir}"
        find . -type f ! -path './checksums.txt' -print | LC_ALL=C sort
      ) >"${actual}" || return 1
      ;;
    true)
      (
        cd -- "${release_dir}"
        find . -type f \
          ! -path './checksums.txt' \
          ! -path './.artifact-sha256' \
          ! -path './.version' \
          -print | LC_ALL=C sort
      ) >"${actual}" || return 1
      ;;
    *)
      return 1
      ;;
  esac
  cmp -s -- "${declared_sorted}" "${actual}"
}

validate_artifact_manifest() {
  local manifest=$1
  jq -e \
    --arg version "${VERSION}" \
    --arg service "${SERVICE_NAME}" \
    --arg arch "${ARCH}" \
    --arg asset "${ASSET_NAME}" \
    --arg root "${ARCHIVE_ROOT_NAME}" \
    '((keys | sort) ==
       ["archive", "build_date", "commit", "compatibility", "component", "platform",
        "schema_version", "source_version"]) and
     (.schema_version == 1) and
     (.component == $service) and
     (.source_version == $version) and
     (.commit | type == "string" and test("^[0-9a-f]{40}$")) and
     (.build_date | type == "string" and
       test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
     (.platform | type == "object") and
     ((.platform | keys | sort) == ["arch", "os"]) and
     (.platform.os == "linux") and
     (.platform.arch == $arch) and
     (.archive | type == "object") and
     ((.archive | keys | sort) == ["name", "root"]) and
     (.archive.name == $asset) and
     (.archive.root == $root) and
     (.compatibility | type == "object") and
     ((.compatibility | keys | sort) ==
       ["database_schema", "minimum_agent_version", "minimum_panel_version",
        "rollback_compatible"]) and
     (.compatibility.minimum_agent_version == "v1.0.0") and
     (.compatibility.minimum_panel_version == null) and
     (.compatibility.rollback_compatible == true) and
     (.compatibility.database_schema == "backward_compatible")' \
    "${manifest}" >/dev/null
}

expected_binary_identity() {
  local manifest=$1
  local commit build_date
  commit=$(jq -r '.commit' "${manifest}") || return 1
  build_date=$(jq -r '.build_date' "${manifest}") || return 1
  printf 'autostream-observability %s\ncommit: %s\nbuild_date: %s' \
    "${VERSION}" "${commit}" "${build_date}"
}

validate_marker() {
  local path=$1
  local expected=$2
  local label=$3
  [[ -f ${path} && ! -L ${path} ]] || die "${label} marker is missing or unsafe"
  [[ $(stat -c '%U:%G:%a' -- "${path}") == "root:root:444" ]] || \
    die "${label} marker owner or mode is invalid"
  [[ $(<"${path}") == "${expected}" ]] || die "${label} marker does not match the verified release"
}

validate_release_tree() {
  local release_dir=$1
  local trusted_checksums=$2
  local scratch_prefix=$3
  [[ -d ${release_dir} && ! -L ${release_dir} ]] || die "managed release is missing or unsafe"
  [[ $(stat -c '%U:%G:%a' -- "${release_dir}") == "root:root:755" ]] || \
    die "managed release root owner or mode is invalid"
  if find "${release_dir}" -mindepth 1 \
    \( -type l -o \( ! -type d ! -type f \) \) \
    -print -quit | grep -q .; then
    die "existing managed release contains a link or special entry"
  fi
  [[ -f ${release_dir}/checksums.txt && ! -L ${release_dir}/checksums.txt ]] || \
    die "managed release checksums are missing or unsafe"
  cmp -s -- "${trusted_checksums}" "${release_dir}/checksums.txt" || \
    die "existing managed release checksums do not match the verified archive"
  validate_checksum_inventory "${release_dir}" "${scratch_prefix}" true || \
    die "existing managed release checksum inventory is incomplete or unsafe"
  (
    cd -- "${release_dir}"
    sha256sum --check --strict checksums.txt
  ) || die "managed release content verification failed"
  validate_marker "${release_dir}/.artifact-sha256" "${ARCHIVE_DIGEST}" "artifact digest"
  validate_marker "${release_dir}/.version" "${VERSION}" "version"
  [[ -x ${release_dir}/${RELEASE_BINARY} && -f ${release_dir}/${RELEASE_BINARY} &&
    ! -L ${release_dir}/${RELEASE_BINARY} ]] || die "managed release binary is missing or unsafe"
}

validate_current_release() {
  if [[ ! -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]]; then
    return
  fi
  [[ -L ${CURRENT_LINK} ]] || die "${CURRENT_LINK} must be an updater-managed symlink"
  local resolved marker_digest marker_version
  resolved=$(readlink -f -- "${CURRENT_LINK}") || die "${CURRENT_LINK} is dangling"
  case "${resolved}" in
    "${RELEASE_ROOT}/"*)
      ;;
    *)
      die "${CURRENT_LINK} points outside ${RELEASE_ROOT}"
      ;;
  esac
  [[ -d ${resolved} && ! -L ${resolved} ]] || die "current managed release is missing or unsafe"
  [[ -f ${resolved}/.artifact-sha256 && ! -L ${resolved}/.artifact-sha256 ]] || \
    die "current managed release digest marker is invalid"
  [[ -f ${resolved}/.version && ! -L ${resolved}/.version ]] || \
    die "current managed release version marker is invalid"
  marker_digest=$(<"${resolved}/.artifact-sha256")
  marker_version=$(<"${resolved}/.version")
  [[ ${marker_digest} =~ ^[0-9a-f]{64}$ ]] || die "current managed release digest marker is invalid"
  [[ ${marker_version} =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || \
    die "current managed release version marker is invalid"
  [[ $(stat -c '%U:%G:%a' -- "${resolved}/.artifact-sha256") == "root:root:444" ]] || \
    die "current digest marker owner or mode is invalid"
  [[ $(stat -c '%U:%G:%a' -- "${resolved}/.version") == "root:root:444" ]] || \
    die "current version marker owner or mode is invalid"
  [[ -f ${resolved}/checksums.txt && ! -L ${resolved}/checksums.txt ]] || \
    die "current managed release checksums are invalid"
  (
    cd -- "${resolved}"
    sha256sum --check --strict checksums.txt
  ) >/dev/null || die "current managed release content is corrupt"
}

validate_secure_existing_file() {
  local path=$1
  local expected=$2
  local label=$3
  [[ -f ${path} && ! -L ${path} ]] || die "${label} must be a regular non-symlink file"
  [[ $(stat -c '%U:%G:%a' -- "${path}") == "${expected}" ]] || \
    die "${label} owner or mode is invalid"
}

validate_replaceable_regular_file() {
  local path=$1
  local label=$2
  local mode
  [[ -f ${path} && ! -L ${path} ]] || die "${label} must be a regular non-symlink file"
  [[ $(stat -c '%U:%G' -- "${path}") == "root:root" ]] || die "${label} must be owned by root:root"
  mode=$(stat -c '%a' -- "${path}")
  (( (8#${mode} & 07022) == 0 )) || \
    die "${label} must not have special bits or be writable by group or other"
}

validate_public_path() {
  local path=$1
  local expected_target=$2
  local label=$3
  local resolved expected_resolved
  if [[ ! -e ${path} && ! -L ${path} ]]; then
    return
  fi
  if [[ -L ${path} ]]; then
    [[ $(stat -c '%U:%G' -- "${path}") == "root:root" ]] || die "${label} symlink must be owned by root:root"
    if [[ $(readlink -- "${path}") == "${expected_target}" ]]; then
      return
    fi
    resolved=$(readlink -f -- "${path}" 2>/dev/null || true)
    expected_resolved=$(readlink -f -- "${expected_target}" 2>/dev/null || true)
    [[ -n ${resolved} && -n ${expected_resolved} && ${resolved} == "${expected_resolved}" ]] || \
      die "${label} is an unmanaged symlink"
    return
  fi
  validate_replaceable_regular_file "${path}" "${label}"
  [[ -x ${path} ]] || die "${label} legacy binary is not executable"
}

create_bound_stage_directory() {
  local output_path_variable=$1
  local output_identity_variable=$2
  local template=$3
  local expected_prefix=$4
  local expected_parent=$5
  local path="" identity="" creation_failed=false

  begin_installer_signal_transaction
  if ! path=$(mktemp -d "${template}"); then
    creation_failed=true
  elif [[ -z ${path} ||
    ${path} != "${expected_prefix}"* ||
    $(dirname -- "${path}") != "${expected_parent}" ||
    ! -d ${path} ||
    -L ${path} ||
    $(readlink -f -- "${path}") != "${path}" ||
    $(stat -c '%U:%G:%a' -- "${path}") != "root:root:700" ]]; then
    creation_failed=true
  elif ! identity=$(stat -c '%d:%i' -- "${path}"); then
    creation_failed=true
  else
    printf -v "${output_path_variable}" '%s' "${path}"
    printf -v "${output_identity_variable}" '%s' "${identity}"
  fi
  if [[ ${creation_failed} == true &&
    -n ${path} &&
    ${path} == "${expected_prefix}"* &&
    $(dirname -- "${path}") == "${expected_parent}" &&
    -d ${path} &&
    ! -L ${path} &&
    $(readlink -f -- "${path}") == "${path}" ]]; then
    rm -rf -- "${path}" || true
  fi
  finish_installer_signal_transaction
  [[ ${creation_failed} == false ]]
}

reserve_path() {
  local output_variable=$1
  local directory=$2
  local template=$3
  local reserved="" reservation_failed=false

  printf -v "${output_variable}" '%s' ""
  begin_installer_signal_transaction
  if ! reserved=$(mktemp "${directory}/${template}.XXXXXX"); then
    reservation_failed=true
  elif [[ -z ${reserved} ||
    ${reserved} != "${directory}/${template}."* ||
    $(dirname -- "${reserved}") != "${directory}" ||
    ! -f ${reserved} ||
    -L ${reserved} ]]; then
    reservation_failed=true
  else
    register_temporary_rollback_path "${reserved}"
    if ! rm -f -- "${reserved}"; then
      reservation_failed=true
    else
      printf -v "${output_variable}" '%s' "${reserved}"
    fi
  fi
  if [[ ${reservation_failed} == true &&
    -n ${reserved} &&
    ${reserved} == "${directory}/${template}."* &&
    $(dirname -- "${reserved}") == "${directory}" &&
    -f ${reserved} &&
    ! -L ${reserved} ]]; then
    rm -f -- "${reserved}" || true
  fi
  finish_installer_signal_transaction
  [[ ${reservation_failed} == false ]]
}

ensure_permanent_lock_directory() {
  local path=$1
  # updater target lock is permanent installer coordination state.
  if [[ -e ${path} || -L ${path} ]]; then
    [[ -d ${path} &&
      ! -L ${path} &&
      $(readlink -f -- "${path}") == "${path}" &&
      $(stat -c '%U:%G:%a' -- "${path}") == "root:root:700" ]] || \
      die "permanent updater lock directory is unsafe: ${path}"
  else
    install -d -o root -g root -m 0700 -- "${path}"
    [[ -d ${path} &&
      ! -L ${path} &&
      $(readlink -f -- "${path}") == "${path}" &&
      $(stat -c '%U:%G:%a' -- "${path}") == "root:root:700" ]] || \
      die "could not create the permanent updater lock directory"
    sync -f -- "$(dirname -- "${path}")" || \
      die "could not synchronize the permanent updater lock directory"
  fi
}

sync_existing_directories_best_effort() {
  local failed=false
  local directory
  for directory in "$@"; do
    if [[ -e ${directory} || -L ${directory} ]]; then
      if [[ ! -d ${directory} || -L ${directory} ]]; then
        failed=true
        continue
      fi
      sync -f -- "${directory}" || failed=true
    fi
  done
  [[ ${failed} == false ]]
}

sync_required_directories() {
  local directory
  for directory in "$@"; do
    [[ -d ${directory} && ! -L ${directory} ]] || return 1
    sync -f -- "${directory}" || return 1
  done
}

sync_common_installation_parents_best_effort() {
  sync_existing_directories_best_effort \
    / \
    /opt \
    /opt/autostream \
    "${MANAGED_ROOT}" \
    "${RELEASE_ROOT}" \
    /usr \
    /usr/local \
    /usr/local/bin \
    /usr/local/sbin \
    /etc \
    /etc/systemd \
    /etc/systemd/system \
    /etc/autostream \
    "${BACKUP_CONFIG_DIR}" \
    /var \
    /var/lib \
    /var/lib/autostream \
    "${STATE_DIR}" \
    /var/backups \
    /var/backups/autostream \
    "${INSTALL_MIGRATION_ROOT}" \
    "${INSTALL_MIGRATION_SERVICE_ROOT}" \
    "${BACKUP_DIR}" \
    /run \
    /run/autostream-updater
}

verify_legacy_backup_file() {
  local backup_path=$1
  local expected_digest=${2-}
  validate_replaceable_regular_file "${backup_path}" "retained legacy backup"
  if [[ -n ${expected_digest} &&
    $(sha256sum -- "${backup_path}" | awk 'NR == 1 { print $1 }') != "${expected_digest}" ]]; then
    die "retained legacy backup content conflicts with the live file: ${backup_path}"
  fi
  if [[ ${preexisting_legacy_backup_identity["${backup_path}"]+present} == present ]]; then
    [[ $(stat -c '%d:%i:%s:%Y:%Z:%f:%u:%g:%a' -- "${backup_path}") == \
      "${preexisting_legacy_backup_identity["${backup_path}"]}" ]] || \
      die "pre-existing legacy backup identity or metadata changed during installation: ${backup_path}"
    [[ $(sha256sum -- "${backup_path}" | awk 'NR == 1 { print $1 }') == \
      "${preexisting_legacy_backup_digest["${backup_path}"]}" ]] || \
      die "pre-existing legacy backup content changed during installation: ${backup_path}"
  fi
}

snapshot_legacy_backup_path() {
  local backup_path=$1
  if [[ -e ${backup_path} || -L ${backup_path} ]]; then
    verify_legacy_backup_file "${backup_path}"
    legacy_backup_existed_before["${backup_path}"]=true
    preexisting_legacy_backup_identity["${backup_path}"]="$(stat -c '%d:%i:%s:%Y:%Z:%f:%u:%g:%a' -- "${backup_path}")"
    preexisting_legacy_backup_digest["${backup_path}"]="$(sha256sum -- "${backup_path}" | awk 'NR == 1 { print $1 }')"
  else
    legacy_backup_existed_before["${backup_path}"]=false
  fi
}

retain_legacy_file() {
  local should_retain=$1
  local source=$2
  local destination=$3
  local label=$4
  local source_digest source_mode staged
  [[ ${should_retain} == true ]] || return 0
  validate_replaceable_regular_file "${source}" "${label}"
  source_digest=$(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }') || \
    die "failed to hash ${label}"
  [[ ${source_digest} =~ ^[0-9a-f]{64}$ ]] || die "failed to hash ${label}"
  source_mode=$(stat -c '%a' -- "${source}") || die "failed to inspect ${label}"
  if [[ -e ${destination} || -L ${destination} ]]; then
    [[ ${legacy_backup_existed_before["${destination}"]-false} == true ]] || \
      die "legacy backup path appeared after preflight: ${destination}"
    validate_replaceable_regular_file "${destination}" "retained ${label}"
    [[ $(stat -c '%a' -- "${destination}") == "${source_mode}" ]] || \
      die "retained ${label} mode conflicts with the live file"
    [[ $(sha256sum -- "${destination}" | awk 'NR == 1 { print $1 }') == "${source_digest}" ]] || \
      die "retained ${label} content conflicts with the live file"
    return
  fi
  reserve_path staged "${INSTALL_BACKUP_DIR}" ".legacy.next" || \
    die "failed to reserve ${label} retention path"
  install -o root -g root -m "${source_mode}" -- "${source}" "${staged}"
  [[ $(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }') == "${source_digest}" ]] || \
    die "${label} changed while it was retained"
  [[ $(sha256sum -- "${staged}" | awk 'NR == 1 { print $1 }') == "${source_digest}" ]] || \
    die "retained ${label} differs from its source"
  mv -T -- "${staged}" "${destination}"
  validate_replaceable_regular_file "${destination}" "retained ${label}"
  created_legacy_backup_identity["${destination}"]="$(stat -c '%d:%i:%s:%Y:%Z:%f:%u:%g:%a' -- "${destination}")"
  created_legacy_backup_digest["${destination}"]="$(sha256sum -- "${destination}" | awk 'NR == 1 { print $1 }')"
  sync -f -- "${INSTALL_BACKUP_DIR}" || die "failed to synchronize retained ${label}"
}

stage_symlink() {
  local output_variable=$1
  local target=$2
  local directory=$3
  local template=$4
  local staged="" staging_failed=false

  reserve_path staged "${directory}" "${template}" || return 1
  begin_installer_signal_transaction
  if ! ln -s -- "${target}" "${staged}"; then
    staging_failed=true
  elif [[ ! -L ${staged} || $(readlink -- "${staged}") != "${target}" ]]; then
    staging_failed=true
  else
    printf -v "${output_variable}" '%s' "${staged}"
  fi
  finish_installer_signal_transaction
  [[ ${staging_failed} == false ]]
}

backup_destination() {
  local output_variable=$1
  local destination=$2
  local directory=$3
  local template=$4
  local backup="" target="" backup_failed=false

  printf -v "${output_variable}" '%s' ""
  if [[ -e ${destination} || -L ${destination} ]]; then
    reserve_path backup "${directory}" "${template}" || return 1
    begin_installer_signal_transaction
    if [[ -L ${destination} ]]; then
      if ! target=$(readlink -- "${destination}"); then
        backup_failed=true
      elif ! ln -s -- "${target}" "${backup}"; then
        backup_failed=true
      elif [[ ! -L ${backup} || $(readlink -- "${backup}") != "${target}" ]]; then
        backup_failed=true
      fi
    elif [[ -f ${destination} ]]; then
      if ! ln -- "${destination}" "${backup}"; then
        backup_failed=true
      elif [[ ! -f ${backup} || -L ${backup} ||
        $(stat -c '%d:%i' -- "${backup}") != "$(stat -c '%d:%i' -- "${destination}")" ]]; then
        backup_failed=true
      fi
    else
      backup_failed=true
    fi
    if [[ ${backup_failed} == false ]]; then
      printf -v "${output_variable}" '%s' "${backup}"
    fi
    finish_installer_signal_transaction
  fi
  [[ ${backup_failed} == false ]]
}

restore_destination() {
  local destination=$1
  local backup=$2
  local failed=false
  rm -f -- "${destination}" || failed=true
  if [[ -n ${backup} && ( -e ${backup} || -L ${backup} ) ]]; then
    mv -T -- "${backup}" "${destination}" || failed=true
  fi
  [[ ${failed} == false ]]
}

rollback_state_and_backup_directories() {
  local failed=false
  if [[ ${installation_complete} == false && ${state_dir_touched} == true ]]; then
    if [[ ${state_dir_existed} == true ]]; then
      if [[ -d ${STATE_DIR} && ! -L ${STATE_DIR} &&
        $(stat -c '%d:%i' -- "${STATE_DIR}") == "${state_dir_original_identity}" ]]; then
        chown -- "${state_dir_original_uid}:${state_dir_original_gid}" "${STATE_DIR}" || \
          failed=true
        chmod -- "${state_dir_original_mode}" "${STATE_DIR}" || failed=true
        [[ $(stat -c '%d:%i:%u:%g:%a' -- "${STATE_DIR}") == \
          "${state_dir_original_identity}:${state_dir_original_uid}:${state_dir_original_gid}:${state_dir_original_mode}" ]] || \
          failed=true
      else
        failed=true
      fi
    elif [[ -e ${STATE_DIR} || -L ${STATE_DIR} ]]; then
      if [[ -d ${STATE_DIR} && ! -L ${STATE_DIR} &&
        -n ${state_dir_created_identity} &&
        $(stat -c '%d:%i' -- "${STATE_DIR}") == "${state_dir_created_identity}" &&
        -z $(find "${STATE_DIR}" -mindepth 1 -print -quit) ]]; then
        rmdir -- "${STATE_DIR}" || failed=true
      else
        failed=true
      fi
      [[ ! -e ${STATE_DIR} && ! -L ${STATE_DIR} ]] || failed=true
    fi
  fi
  if [[ ${installation_complete} == false && ${backup_dir_touched} == true ]]; then
    if [[ ${backup_dir_existed} == true ]]; then
      if [[ -d ${BACKUP_DIR} && ! -L ${BACKUP_DIR} &&
        $(stat -c '%d:%i' -- "${BACKUP_DIR}") == "${backup_dir_original_identity}" ]]; then
        chown -- "${backup_dir_original_uid}:${backup_dir_original_gid}" "${BACKUP_DIR}" || \
          failed=true
        chmod -- "${backup_dir_original_mode}" "${BACKUP_DIR}" || failed=true
        [[ $(stat -c '%d:%i:%u:%g:%a' -- "${BACKUP_DIR}") == \
          "${backup_dir_original_identity}:${backup_dir_original_uid}:${backup_dir_original_gid}:${backup_dir_original_mode}" ]] || \
          failed=true
      else
        failed=true
      fi
    elif [[ -e ${BACKUP_DIR} || -L ${BACKUP_DIR} ]]; then
      if [[ -d ${BACKUP_DIR} && ! -L ${BACKUP_DIR} &&
        -n ${backup_dir_created_identity} &&
        $(stat -c '%d:%i' -- "${BACKUP_DIR}") == "${backup_dir_created_identity}" &&
        -z $(find "${BACKUP_DIR}" -mindepth 1 -print -quit) ]]; then
        rmdir -- "${BACKUP_DIR}" || failed=true
      else
        failed=true
      fi
      [[ ! -e ${BACKUP_DIR} && ! -L ${BACKUP_DIR} ]] || failed=true
    fi
  fi
  [[ ${failed} == false ]]
}

rollback_created_managed_release() {
  local failed=false
  local public_path
  [[ ${managed_release_created} == true ]] || return 0
  [[ -n ${RELEASE_DIR} ]] || return 1
  if [[ ! -e ${RELEASE_DIR} && ! -L ${RELEASE_DIR} ]]; then
    return 0
  fi
  [[ -d ${RELEASE_DIR} && ! -L ${RELEASE_DIR} &&
    $(readlink -f -- "${RELEASE_DIR}") == "${RELEASE_DIR}" &&
    $(stat -c '%d:%i' -- "${RELEASE_DIR}") == "${managed_release_created_identity}" ]] || \
    return 1
  if [[ -L ${CURRENT_LINK} && $(readlink -f -- "${CURRENT_LINK}") == "${RELEASE_DIR}" ]]; then
    return 1
  fi
  for public_path in "${PUBLIC_BINARY}" "${PUBLIC_ALIAS}"; do
    if [[ -L ${public_path} &&
      $(readlink -f -- "${public_path}") == "${RELEASE_DIR}/${RELEASE_BINARY}" ]]; then
      return 1
    fi
  done
  rm -rf -- "${RELEASE_DIR}" || failed=true
  [[ ! -e ${RELEASE_DIR} && ! -L ${RELEASE_DIR} ]] || failed=true
  if [[ -d ${RELEASE_ROOT} && ! -L ${RELEASE_ROOT} ]]; then
    sync -f -- "${RELEASE_ROOT}" || failed=true
  fi
  [[ ${failed} == false ]]
}

rollback_journaled_directories() {
  local index path current_mode failed=false
  for ((index=${#journaled_directory_paths[@]} - 1; index >= 0; index--)); do
    path="${journaled_directory_paths[index]}"
    if [[ ${directory_existed["${path}"]} == true ]]; then
      if [[ -d ${path} && ! -L ${path} &&
        $(readlink -f -- "${path}") == "${path}" &&
        $(stat -c '%d:%i' -- "${path}") == "${directory_original_identity["${path}"]}" ]]; then
        chown -- "${directory_original_owner["${path}"]}" "${path}" || failed=true
        chmod -- "${directory_original_mode["${path}"]}" "${path}" || failed=true
        [[ $(stat -c '%d:%i:%u:%g:%a' -- "${path}") == \
          "${directory_original_identity["${path}"]}:${directory_original_owner["${path}"]}:${directory_original_mode["${path}"]}" ]] || \
          failed=true
      else
        failed=true
      fi
    elif [[ -e ${path} || -L ${path} ]]; then
      if [[ -d ${path} && ! -L ${path} &&
        $(readlink -f -- "${path}") == "${path}" &&
        -n ${directory_created_identity["${path}"]-} &&
        $(stat -c '%d:%i' -- "${path}") == "${directory_created_identity["${path}"]}" ]]; then
        if [[ -z $(find "${path}" -mindepth 1 -print -quit) ]]; then
          rmdir -- "${path}" || failed=true
          [[ ! -e ${path} && ! -L ${path} ]] || failed=true
        else
          current_mode=$(stat -c '%a' -- "${path}")
          if [[ ${directory_retain_if_nonempty["${path}"]} == true &&
            $(stat -c '%U:%G' -- "${path}") == "root:root" &&
            ${current_mode} =~ ^[0-7]+$ ]] &&
            (( (8#${current_mode} & 0022) == 0 )); then
            printf 'install-autostream-observability: retaining non-empty durable backup directory after rollback: %s\n' \
              "${path}" >&2
          else
            failed=true
          fi
        fi
      else
        failed=true
      fi
    fi
  done
  [[ ${failed} == false ]]
}

rollback_autostream_account() {
  local failed=false current_group
  if [[ ${created_autostream_user} == true ]]; then
    if [[ $(getent passwd autostream 2>/dev/null || true) == "${created_autostream_user_record}" &&
      $(id -u autostream 2>/dev/null || true) == "${created_autostream_user_uid}" &&
      $(id -g autostream 2>/dev/null || true) == "${created_autostream_user_gid}" ]]; then
      userdel autostream || failed=true
      getent passwd autostream >/dev/null 2>&1 && failed=true
    else
      failed=true
    fi
  fi
  if [[ ${created_autostream_group} == true ]]; then
    current_group=$(getent group autostream 2>/dev/null || true)
    if [[ -z ${current_group} ]]; then
      :
    elif [[ ${current_group} == "${created_autostream_group_record}" &&
      $(printf '%s\n' "${current_group}" | awk -F: 'NR == 1 { print $3 }') == \
        "${created_autostream_group_gid}" ]] &&
      ! getent passwd autostream >/dev/null 2>&1; then
      groupdel autostream || failed=true
      getent group autostream >/dev/null 2>&1 && failed=true
    else
      failed=true
    fi
  fi
  [[ ${failed} == false ]]
}

verify_bound_legacy_backups() {
  local path failed=false
  for path in "${!preexisting_legacy_backup_identity[@]}"; do
    [[ -f ${path} && ! -L ${path} &&
      $(stat -c '%d:%i:%s:%Y:%Z:%f:%u:%g:%a' -- "${path}") == \
        "${preexisting_legacy_backup_identity["${path}"]}" &&
      $(sha256sum -- "${path}" | awk 'NR == 1 { print $1 }') == \
        "${preexisting_legacy_backup_digest["${path}"]}" ]] || failed=true
  done
  for path in "${!created_legacy_backup_identity[@]}"; do
    [[ -f ${path} && ! -L ${path} &&
      $(stat -c '%d:%i:%s:%Y:%Z:%f:%u:%g:%a' -- "${path}") == \
        "${created_legacy_backup_identity["${path}"]}" &&
      $(sha256sum -- "${path}" | awk 'NR == 1 { print $1 }') == \
        "${created_legacy_backup_digest["${path}"]}" ]] || failed=true
  done
  [[ ${failed} == false ]]
}

cleanup_temporary_rollback_paths() {
  local index path failed=false
  for ((index=${#temporary_rollback_paths[@]} - 1; index >= 0; index--)); do
    path="${temporary_rollback_paths[index]}"
    if [[ -e ${path} || -L ${path} ]]; then
      rm -f -- "${path}" || failed=true
      [[ ! -e ${path} && ! -L ${path} ]] || failed=true
    fi
  done
  [[ ${failed} == false ]]
}

remove_transaction_stage_directory() {
  local path=$1
  local expected_identity=$2
  [[ -n ${path} ]] || return 0
  if [[ ! -e ${path} && ! -L ${path} ]]; then
    return 0
  fi
  [[ -n ${expected_identity} &&
    -d ${path} &&
    ! -L ${path} &&
    $(readlink -f -- "${path}") == "${path}" &&
    $(stat -c '%d:%i' -- "${path}") == "${expected_identity}" ]] || \
    return 1
  rm -rf -- "${path}" || return 1
  [[ ! -e ${path} && ! -L ${path} ]]
}

cleanup() {
  local status=$?
  local cleanup_failed=false
  local setup_rollback_safe=true
  local restore_link
  set +e
  cleanup_in_progress=true
  signal_transaction_active=false
  deferred_termination_status=0
  trap - EXIT
  trap '' HUP INT TERM
  if [[ ${installation_complete} == false && ${commit_started} == true ]]; then
    [[ ${unit_quiesced} != true ]] ||
      restore_destination "${UNIT_DEST}" "${unit_backup}" || {
        cleanup_failed=true
        setup_rollback_safe=false
      }
    [[ ${backup_exec_quiesced} != true ]] ||
      restore_destination "${BACKUP_DEST}" "${backup_exec_backup}" || {
        cleanup_failed=true
        setup_rollback_safe=false
      }
    [[ ${alias_quiesced} != true ]] ||
      restore_destination "${PUBLIC_ALIAS}" "${alias_backup}" || {
        cleanup_failed=true
        setup_rollback_safe=false
      }
    [[ ${binary_quiesced} != true ]] ||
      restore_destination "${PUBLIC_BINARY}" "${binary_backup}" || {
        cleanup_failed=true
        setup_rollback_safe=false
      }
    if [[ ${env_created} == true ]]; then
      if [[ -f ${ENV_DEST} && ! -L ${ENV_DEST} &&
        $(stat -c '%d:%i:%s:%Y:%Z:%f:%u:%g:%a' -- "${ENV_DEST}") == "${env_created_identity}" &&
        $(sha256sum -- "${ENV_DEST}" | awk 'NR == 1 { print $1 }') == "${env_created_digest}" ]]; then
        rm -f -- "${ENV_DEST}" || {
          cleanup_failed=true
          setup_rollback_safe=false
        }
      else
        cleanup_failed=true
        setup_rollback_safe=false
      fi
    fi
    if [[ ${backup_config_created} == true ]]; then
      if [[ -f ${BACKUP_CONFIG_DEST} && ! -L ${BACKUP_CONFIG_DEST} &&
        $(stat -c '%d:%i:%s:%Y:%Z:%f:%u:%g:%a' -- "${BACKUP_CONFIG_DEST}") == \
          "${backup_config_created_identity}" &&
        $(sha256sum -- "${BACKUP_CONFIG_DEST}" | awk 'NR == 1 { print $1 }') == \
          "${backup_config_created_digest}" ]]; then
        rm -f -- "${BACKUP_CONFIG_DEST}" || {
          cleanup_failed=true
          setup_rollback_safe=false
        }
      else
        cleanup_failed=true
        setup_rollback_safe=false
      fi
    fi
    if [[ ${current_switched} == true ]]; then
      if [[ ${current_original_exists} == true ]]; then
        reserve_path restore_link "${MANAGED_ROOT}" ".current.restore" || {
          cleanup_failed=true
          setup_rollback_safe=false
        }
        if [[ -n ${restore_link} ]]; then
          ln -s -- "${current_original_target}" "${restore_link}" || {
            cleanup_failed=true
            setup_rollback_safe=false
          }
          [[ ! -L ${restore_link} ]] ||
            mv -Tf -- "${restore_link}" "${CURRENT_LINK}" || {
              cleanup_failed=true
              setup_rollback_safe=false
            }
        fi
        [[ -L ${CURRENT_LINK} &&
          $(readlink -- "${CURRENT_LINK}") == "${current_original_target}" ]] || \
          {
            cleanup_failed=true
            setup_rollback_safe=false
          }
      else
        rm -f -- "${CURRENT_LINK}" || {
          cleanup_failed=true
          setup_rollback_safe=false
        }
        [[ ! -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]] || {
          cleanup_failed=true
          setup_rollback_safe=false
        }
      fi
    fi
    systemctl daemon-reload >/dev/null 2>&1 || {
      cleanup_failed=true
      setup_rollback_safe=false
    }
  fi
  if [[ ${installation_complete} == false ]]; then
    remove_transaction_stage_directory \
      "${MANAGED_STAGE_DIR}" "${managed_stage_dir_identity}" || {
      cleanup_failed=true
      setup_rollback_safe=false
    }
    rollback_state_and_backup_directories || {
      cleanup_failed=true
      setup_rollback_safe=false
    }
    rollback_created_managed_release || {
      cleanup_failed=true
      setup_rollback_safe=false
    }
    rollback_journaled_directories || {
      cleanup_failed=true
      setup_rollback_safe=false
    }
    if [[ ${setup_rollback_safe} == true ]]; then
      rollback_autostream_account || cleanup_failed=true
    else
      printf 'install-autostream-observability: retaining the service account because setup rollback was incomplete\n' >&2
    fi
    verify_bound_legacy_backups || cleanup_failed=true
  fi
  cleanup_temporary_rollback_paths || cleanup_failed=true
  if [[ -n ${lock_create_stage} && ( -e ${lock_create_stage} || -L ${lock_create_stage} ) ]]; then
    rm -f -- "${lock_create_stage}" || cleanup_failed=true
  fi
  if [[ -n ${shared_lock_create_stage} &&
    ( -e ${shared_lock_create_stage} || -L ${shared_lock_create_stage} ) ]]; then
    rm -f -- "${shared_lock_create_stage}" || cleanup_failed=true
  fi
  if [[ ${installation_complete} == true ]]; then
    remove_transaction_stage_directory \
      "${MANAGED_STAGE_DIR}" "${managed_stage_dir_identity}" || cleanup_failed=true
  fi
  if [[ ${preserve_stage_directories} == false ]]; then
    remove_transaction_stage_directory "${STAGE_DIR}" "${stage_dir_identity}" || cleanup_failed=true
  fi
  if [[ ${transaction_journal_active} == true ]]; then
    sync_common_installation_parents_best_effort || cleanup_failed=true
  fi
  if [[ ${cleanup_failed} == true ]]; then
    printf 'install-autostream-observability: cleanup or rollback was incomplete; inspect %s, %s, and retained backups before retrying\n' \
      "${STAGE_DIR:-unset}" "${MANAGED_STAGE_DIR:-unset}" >&2
    (( status != 0 )) || status=1
  fi
  exit "${status}"
}

