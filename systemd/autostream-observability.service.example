[Unit]
Description=observability
After=network-online.target
Wants=network-online.target

[Service]
User=autostream
Group=autostream
EnvironmentFile=/etc/autostream/observability.env
# Read the Panel-issued v2 listener projection without exposing its private parent.
LoadCredential=node-listener.json:/opt/autostream/local-executor/ports/observability.json
ExecStart=/usr/local/bin/autostream-observability
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/autostream/observability
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
